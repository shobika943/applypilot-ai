PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/applypilot
JWT_SECRET=change_this_to_a_long_random_string
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Free at https://developer.adzuna.com/ - used to auto-fetch live jobs
# (aggregated from LinkedIn, Naukri, Indeed, company sites, etc.) that
# match the user's resume, with a working "apply" redirect to the
# original posting.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
